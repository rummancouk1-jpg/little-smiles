# Copy to `.env.local` for development. Set these in Vercel → Project → Settings → Environment Variables.

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Contact form delivery (set at least one in production) ---
# Resend: https://resend.com — verify your domain; `from` must use that domain (or Resend sandbox).
# Node 20+ required locally; Vercel is fine.
# CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL are required whenever RESEND_API_KEY is set
# (see lib/runtime-env.ts). They also power the COD order-notification email.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Slack / Discord / Zapier / Make — receives JSON payloads for contact + (optionally) WhatsApp clicks
CONTACT_NOTIFY_WEBHOOK_URL=

# --- WhatsApp intent logging (optional) ---
# If unset, WhatsApp events reuse CONTACT_NOTIFY_WEBHOOK_URL
WHATSAPP_CLICK_WEBHOOK_URL=
