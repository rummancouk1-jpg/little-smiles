[32m+[m[32m  code?: string | null;[m
[32m+[m[32m  message?: string | null;[m
[32m+[m[32m  details?: string | null;[m
[32m+[m[32m  hint?: string | null;[m
[32m+[m[32m};[m
[32m+[m
[32m+[m[32mconst TABLE_TO_MIGRATION: Record<string, string> = {[m
[32m+[m[32m  contentops_drafts: "supabase/contentops-schema.sql",[m
[32m+[m[32m  contentops_topics: "supabase/contentops-topics-schema.sql",[m
[32m+[m[32m  contentops_notification_preferences: "supabase/contentops-notifications-schema.sql",[m
[32m+[m[32m};[m
[32m+[m
[32m+[m[32mfunction migrationFor(table: string): string | null {[m
[32m+[m[32m  return TABLE_TO_MIGRATION[table] ?? null;[m
[32m+[m[32m}[m
