[32m+[m[32mexport function isMissingTableError(err: SupabaseLikeError | null | undefined): boolean {[m
[32m+[m[32m  if (!err) return false;[m
[32m+[m[32m  if (err.code === "PGRST205") return true;[m
[32m+[m[32m  const msg = (err.message ?? "").toLowerCase();[m
[32m+[m[32m  return msg.includes("could not find the table") && msg.includes("schema cache");[m
